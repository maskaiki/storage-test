# ==========================================
# KONFIGURASI BOT TELEGRAM TEMAN
# ==========================================

# 1. Token Bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxx

# 2. ID Channel Private Penyimpanan (Format berawalan -100...)
STORAGE_CHANNEL_ID=-100xxxxxxxxxx

# 3. ID Telegram Teman (Cek lewat @userinfobot). 
# Jika dikosongkan, bot otomatis mengenali siapa saja yang pertama klik /start sebagai pemiliknya!
OWNER_CHAT_ID=

# 4. Port Web Server untuk Health Check Cloud (Render / Railway / Koyeb)
PORT=3000
